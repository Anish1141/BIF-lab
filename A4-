#A4-ML for genomic data
from sklearn.datasets import load_breast_cancer
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.svm import SVC
from sklearn.metrics import accuracy_score, classification_report
import pandas as pd

data = load_breast_cancer()
X_tr, X_te, y_tr, y_te = train_test_split(data.data, data.target,
                                          test_size=0.2, random_state=42)
rf  = RandomForestClassifier(100, random_state=42).fit(X_tr, y_tr)
svm = SVC(kernel="linear").fit(X_tr, y_tr)

print("RF  acc:", accuracy_score(y_te, rf.predict(X_te)))
print("SVM acc:", accuracy_score(y_te, svm.predict(X_te)))
print(classification_report(y_te, rf.predict(X_te)))

# Predictive features (the "markers")
imp = pd.Series(rf.feature_importances_, index=data.feature_names)
print(imp.sort_values(ascending=False).head(5))
